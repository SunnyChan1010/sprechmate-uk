{
  "name": "sprechmate-uk",
  "version": "1.6.1",
  "description": "SprechMate (UK Edition) - British English Survival & Reading Fluency PWA with AI Spaced Repetition and Articulatory Anatomy Diagrams",
  "main": "index.html",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./start-uk.ps1",
    "serve": "npx serve -p 8000 -l 127.0.0.1 .",
    "test:syntax": "node tests/check-syntax.js",
    "test:unit": "node --test tests/unit.test.js tests/appsec_remediation.test.js",
    "test": "npm run test:syntax && npm run test:unit",
    "deploy": "cf deploy"
  },
  "keywords": [
    "english-learning",
    "british-english",
    "pwa",
    "speech-assessment",
    "spaced-repetition",
    "sm-2",
    "azure-speech",
    "gemini-api"
  ],
  "author": "SprechMate Community & UK Edition Contributors",
  "license": "MIT",
  "devDependencies": {
    "cf": "^1.0.0-beta.14",
    "wrangler": "^4.149.0"
  }
}
